# OpsPilot local development environment.
# Copy to .env and keep placeholder / non-secret local demo values only.
# Never commit a real .env or a real credential.

# --- PostgreSQL (consumed by docker compose) ---
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_local_dev
POSTGRES_DB=opspilot
POSTGRES_PORT=5432

# --- Backend ---
# Host-side URL: the backend runs on the host, Postgres is published on localhost.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot_local_dev@localhost:5432/opspilot
# Destructive database tests (downgrade/reset) run ONLY against this database.
# It must differ from DATABASE_URL and its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://opspilot:opspilot_local_dev@localhost:5432/opspilot_test
ENVIRONMENT=development
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Hours before the analysis window in which timeline events are added to the Evidence Bundle.
EVIDENCE_EVENT_LOOKBACK_HOURS=72

# --- AI provider (OpenAI). Leave blank to run without AI: brief generation then returns
# the explicit LLM_NOT_CONFIGURED error. Never commit a real key. ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# --- Evaluation (Spec 13). The optional model-based citation judge calls the OpenAI API
# only when this is true AND the key/model above are set; otherwise it reports not_run. ---
EVAL_MODEL_ENABLED=false
EVAL_REPORTS_DIR=evals/reports

# --- Observability (Spec 14). Logs are JSON on stdout by default (LOG_FORMAT=text for
# local reading). Model prices change, so none is hard-coded: cost is estimated only when
# BOTH per-million-token USD prices are set; otherwise traces and /system show
# "not configured". Copy current prices from your provider's pricing page. ---
LOG_LEVEL=INFO
LOG_FORMAT=json
OPENAI_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=

# --- Frontend (Vite only exposes VITE_* variables to the browser bundle) ---
VITE_API_BASE_URL=http://localhost:8000
